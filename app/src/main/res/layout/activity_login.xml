<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <!-- Theme Toggle -->
        <ImageButton
            android:id="@+id/themeToggleBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:background="@drawable/bg_radio_option"
            android:src="@android:drawable/ic_menu_day"
            android:contentDescription="Toggle theme"
            android:tint="@color/accent_red"
            android:padding="8dp" />

        <!-- Main content -->
        <LinearLayout
            android:id="@+id/loginContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHIPWISE"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="#E53935"
                android:letterSpacing="0.16"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in to your account"
                android:textSize="14sp"
                android:textColor="#AAAAAA"
                android:layout_marginBottom="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_auth_form_card"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EMAIL"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textColor="#AAAAAA"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="you@example.com"
                    android:inputType="textEmailAddress"
                    android:background="@drawable/bg_auth_input"
                    android:textColor="@color/white"
                    android:textColorHint="#888888"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASSWORD"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:textColor="#AAAAAA"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:background="@drawable/bg_auth_input"
                    android:textColor="@color/white"
                    android:textColorHint="#888888"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/loginBtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="SIGN IN"
                    android:textColor="@color/white"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_auth_btn_primary"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/googleLoginBtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Continue with Google"
                    android:textColor="#E53935"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:background="@drawable/bg_auth_btn_outline" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/loginProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/accent_red"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account? "
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/signupText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign up"
                    android:textColor="#E53935"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>