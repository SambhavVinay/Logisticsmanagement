<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@color/dark_text_primary"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checkout"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose your payment method"
                    android:textSize="13sp"
                    android:textColor="@color/dark_text_secondary"
                    android:alpha="0.9"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_security_note_card"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@android:drawable/ic_lock_lock"
                    android:tint="@color/accent_red"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100% Secure Payment"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Amount card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_checkout_total_card"
            android:elevation="2dp"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOTAL AMOUNT"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textColor="@color/dark_text_secondary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/amountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="44sp"
                android:textStyle="bold"
                android:textColor="#E53935" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_security_note_card"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="14dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@android:drawable/ic_lock_lock"
                    android:tint="@color/accent_red"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Secure &amp; Encrypted"
                    android:textSize="11sp"
                    android:textColor="@color/dark_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Payment method label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PAYMENT METHOD"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textColor="@color/dark_text_secondary"
            android:layout_marginBottom="12dp"
            android:paddingStart="2dp" />

        <!-- Radio group styled as cards -->
        <RadioGroup
            android:id="@+id/paymentGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:text="UPI\nFast bank app payments"
                android:textColor="@color/dark_text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:background="@drawable/bg_payment_option_ripple"
                android:buttonTint="@color/accent_red"
                android:drawableStart="@drawable/ic_payment_upi_box"
                android:drawableEnd="@android:drawable/ic_media_next"
                android:drawablePadding="12dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp" />

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:text="Card\nCredit, debit and prepaid cards"
                android:textColor="@color/dark_text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:background="@drawable/bg_payment_option_ripple"
                android:buttonTint="@color/accent_red"
                android:drawableStart="@drawable/ic_payment_card_box"
                android:drawableEnd="@android:drawable/ic_media_next"
                android:drawablePadding="12dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp" />

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:text="Cash on Delivery\nPay when your shipment arrives"
                android:textColor="@color/dark_text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:background="@drawable/bg_payment_option_ripple"
                android:buttonTint="@color/accent_red"
                android:drawableStart="@drawable/ic_payment_cod_box"
                android:drawableEnd="@android:drawable/ic_media_next"
                android:drawablePadding="12dp"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_security_note_card"
            android:elevation="1dp"
            android:padding="14dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_lock_lock"
                android:tint="@color/accent_red"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your payment information is safe with us"
                android:textSize="12sp"
                android:textColor="@color/dark_text_secondary" />
        </LinearLayout>

        <Button
            android:id="@+id/payBtn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text=" PAY NOW"
            android:textColor="@color/white"
            android:letterSpacing="0.08"
            android:textStyle="bold"
            android:background="@drawable/bg_button_red_24"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:elevation="3dp"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/paymentProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/accent_red"
            android:visibility="gone" />

        <TextView
            android:id="@+id/paymentStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:textColor="@color/dark_text_secondary"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>