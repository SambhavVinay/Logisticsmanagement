<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_industrial_ripple"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/shipmentTrackingId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TRK123456"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/shipmentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not Delivered"
            android:textColor="@color/accent_red"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_security_note_card"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/shipmentSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOM"
            android:textColor="@color/slate_400"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" -> "
            android:textColor="@color/slate_400"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/shipmentReceiver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLR"
            android:textColor="@color/slate_400"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:fontFamily="monospace" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/shipmentWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5.0 KG"
            android:textColor="@color/slate_500"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">
        
        <Button
            android:id="@+id/btnNotDelivered"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Not Delivered"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/slate_500"/>
            
        <Button
            android:id="@+id/btnDelivered"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Delivered"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/emerald_500"/>
            
    </LinearLayout>
</LinearLayout>
